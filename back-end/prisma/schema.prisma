generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model tb_user {
  id String @id @default(uuid())
  name  String 
  email String @unique
  password String
  cep String
  admin Boolean @default(false)

  cartItems tb_cart_items[]
  order tb_order[]
}

model tb_product {
  id String @id @default(uuid())
  name String
  description String
  price Int
  category String
  imgUrl String
  createdAt DateTime @default(now())

  cartItems tb_cart_items[]
  orderItems tb_order_items[]
}

model tb_cart_items {
  id String @id @default(uuid())
  quantity Int @default(1)

  productId String 
  product tb_product @relation(fields: [productId], references: [id])

  userId String 
  user tb_user @relation(fields: [userId], references: [id])
}

model tb_order {
  id String @id @default(uuid())
  status String @default("Pendente")
  total Int
  createdAt DateTime @default(now())

  userId String
  user tb_user @relation(fields: [userId], references: [id])

  items tb_order_items[]
}

model tb_order_items {
  id String @id @default(uuid())
  quantity Int
  price Int

  productId String
  product tb_product @relation(fields: [productId], references: [id])

  oderId String
  order tb_order @relation(fields: [oderId], references: [id])
}