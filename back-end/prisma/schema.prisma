generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model tb_user {
  id String @id @default(uuid())
  name  String 
  email String @unique
  password String
  cep String
  admin Boolean @default(false)

  cartItems tb_cart_items[]
}

model tb_product {
  id String @id @default(uuid())
  name String
  description String
  price Int
  category String
  imgUrl String
  createdAt DateTime @default(now())

  cartItems tb_cart_items[]
}

model tb_cart_items {
  id String @id @default(ulid())

  productId String 
  product tb_product @relation(fields: [productId], references: [id])

  userId String 
  user tb_user @relation(fields: [userId], references: [id])

}