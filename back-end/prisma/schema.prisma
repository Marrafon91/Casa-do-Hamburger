generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model tb_user {
  id String @id @default(uuid())
  name  String 
  email String @unique
  password String
  cep String
  admin Boolean @default(false)
}

model tb_product {
  id String @id @default(uuid())
  name String
  description String
  price Int
  category String
  imgUrl String
  createdAt DateTime @default(now())
}